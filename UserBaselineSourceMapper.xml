<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vpp.platform.resource.repository.UserBaselineSourceMapper">

    <select id="selectByConsNosAndDates"
            resultType="com.vpp.platform.resource.baseline.model.UserLoadPoint">
        SELECT ts, load_mw, src_type, cons_no, data_date
        FROM st_user_load_96
        WHERE cons_no IN
        <foreach collection="consNos" item="consNo" open="(" separator="," close=")">
            #{consNo}
        </foreach>
          AND data_date IN
        <foreach collection="dataDates" item="dataDate" open="(" separator="," close=")">
            #{dataDate}
        </foreach>
          AND load_mw IS NOT NULL
        ORDER BY cons_no, ts
    </select>

    <select id="selectByConsNosAndTimeRange"
            resultType="com.vpp.platform.resource.baseline.model.UserLoadPoint">
        SELECT ts, load_mw, src_type, cons_no, data_date
        FROM st_user_load_96
        WHERE cons_no IN
        <foreach collection="consNos" item="consNo" open="(" separator="," close=")">
            #{consNo}
        </foreach>
          AND ts &gt;= #{startTime}
          AND ts &lt;= #{endTime}
          AND load_mw IS NOT NULL
        ORDER BY cons_no, ts
    </select>

</mapper>

